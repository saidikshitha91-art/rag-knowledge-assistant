# Copy to .env or set as environment variables
LLM_PROVIDER=anthropic          # anthropic | ollama
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
# For a free local LLM instead:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1
# Lighter models for low-RAM laptops (8 GB):
